{
  "manifest_version": 3,
  "name": "Clowder",
  "version": "0.1.0",
  "description": "Herds your tabs into groups by rule and domain, with a little help from your local Claude CLI.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clowder: herd your tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "organize-with-claude": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Organize this window's tabs with Claude"
    },
    "group-by-rules": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Group this window's tabs by rules and domain"
    },
    "close-duplicates": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Close duplicate tabs, keeping the most recently loaded copy"
    }
  }
}
